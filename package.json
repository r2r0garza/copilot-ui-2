{
  "name": "deepagents-vscode-spike",
  "displayName": "Deep Agents + Copilot Spike",
  "description": "A spike that runs the Deep Agents harness on top of VS Code's Copilot language models.",
  "version": "0.0.1",
  "private": true,
  "publisher": "local-spike",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepagentsSpike",
          "title": "Deep Agents",
          "icon": "assets/deepagents.svg"
        }
      ]
    },
    "views": {
      "deepagentsSpike": [
        {
          "type": "webview",
          "id": "deepagentsSpike.launcher",
          "name": "Agent Workbench"
        }
      ]
    },
    "commands": [
      {
        "command": "deepagentsSpike.openChat",
        "title": "Deep Agents: Open Chat"
      },
      {
        "command": "deepagentsSpike.inspectProjectCustomizations",
        "title": "Deep Agents: Inspect Project Customizations"
      },
      {
        "command": "deepagentsSpike.inspectRegisteredTools",
        "title": "Deep Agents: Inspect Registered Tools"
      },
      {
        "command": "deepagentsSpike.inspectRuntimeDiagnostics",
        "title": "Deep Agents: Inspect Runtime Diagnostics"
      }
    ],
    "configuration": {
      "title": "Deep Agents + Copilot Spike",
      "properties": {
        "deepagentsSpike.modelFamily": {
          "type": "string",
          "default": "",
          "description": "Optional Copilot model family filter. Leave empty to show all available Copilot models in the workbench."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "npm run check && npm run build && node test/run.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "deepagents": "^1.0.0",
    "langchain": "^1.5.4",
    "markdown-it": "^14.3.0",
    "sanitize-html": "^2.17.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/vscode": "1.105.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
